---
interface Props { variant?: 'default' | 'photo'; }
const { variant = 'default' } = Astro.props;
---
<footer class:list={['site-footer', variant === 'photo' && 'site-footer--photo']}>
  <div class="footer-details">
    <div><p class="footer-label">Studio</p><address>1/3758-B1, Bilathikulam Road<br />Nadakkavu, Kozhikode 673006</address></div>
    <div><p class="footer-label">Contact</p><a href="mailto:agama.work@gmail.com">agama.work@gmail.com</a><a href="tel:+918139092123">+91 81390 92123</a></div>
    <div><p class="footer-label">Follow</p><a href="https://instagram.com/agama_design_collective" target="_blank" rel="noreferrer">Instagram</a><a href="https://youtube.com/@Agamadesigncollective" target="_blank" rel="noreferrer">YouTube</a></div>
  </div>
  <div class="footer-brand">
    <img src="/brand/agama-logo-cropped.png" alt="Agama Design Collective" width="1797" height="1797" />
    <small>© 2020</small>
  </div>
</footer>

<style>
  .site-footer { position:relative;overflow:hidden;padding:76px clamp(24px,5vw,80px) 28px;color:#211c18;background:#dfb486;font-family:var(--font-primary); }
  .footer-top { display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding-bottom:54px;border-bottom:1px solid rgba(255,255,255,.34); }
  .footer-invitation { margin:0;font-size:16px;font-weight:440; }
  .footer-contact { display:inline-flex;align-items:center;gap:18px;font-size:clamp(31px,4.2vw,67px);font-weight:430;line-height:1;letter-spacing:-.045em; }
  .footer-contact svg { flex:0 0 auto;transition:transform 240ms var(--ease-out); }
  .footer-contact:hover svg { transform:translateX(7px); }
  .footer-details { display:grid;grid-template-columns:1.65fr 1fr 1fr;gap:48px;padding:48px 0 78px;font-size:15px;line-height:1.65; }
  .footer-details>div { display:flex;flex-direction:column;align-items:flex-start; }
  .footer-label { margin:0 0 15px;color:#6b3f28;font-size:14px;font-weight:600;letter-spacing:.08em;text-transform:uppercase; }
  address { max-width:34ch;font-style:normal; }
  .footer-details a { position:relative; }
  .footer-details a::after { content:'';position:absolute;right:0;bottom:2px;left:0;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform 220ms var(--ease-out); }
  .footer-details a:hover::after { transform:scaleX(1);transform-origin:left; }
  .footer-wordmark { margin-left:-.055em;font-family:'Iowan Old Style',Baskerville,Georgia,serif;font-size:clamp(112px,22vw,410px);font-weight:700;line-height:.67;letter-spacing:-.075em;color:#75ed91;white-space:nowrap; }
  .footer-brand{display:flex;flex-direction:column;align-items:center;gap:13px;padding-top:34px;border-top:1px solid rgba(33,28,24,.28)}
  .footer-brand img{width:clamp(126px,10vw,166px);height:auto;mix-blend-mode:multiply}
  .footer-brand small{font-size:13px;letter-spacing:.06em}
  @media(max-width:700px){.site-footer{padding-top:56px}.footer-top{display:block;padding-bottom:40px}.footer-contact{margin-top:18px;font-size:clamp(31px,10vw,44px)}.footer-details{grid-template-columns:1fr 1fr;gap:34px 24px;padding:40px 0 58px}.footer-details>div:first-child{grid-column:1/-1}.footer-wordmark{font-size:clamp(104px,38vw,190px)}}
  .site-footer.site-footer--photo{display:flex;flex-direction:column;min-height:0;padding:76px clamp(24px,5vw,80px) 28px;color:#211c18;background:#dfb486}
  .site-footer--photo .footer-label{color:#6b3f28}
  .site-footer--photo .footer-details{padding:48px 0 78px}
  .site-footer--photo .footer-brand{order:3}
  .footer-wordmark-outline{order:4;display:block;width:calc(100% + 2 * clamp(24px,5vw,80px));margin-left:calc(clamp(24px,5vw,80px) * -1);font-size:clamp(112px,20vw,340px);font-weight:460;line-height:1;letter-spacing:-.075em;white-space:nowrap;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.78);text-align:center;transform:scaleX(1.48);transform-origin:center bottom}
  @media(max-width:700px){.site-footer--photo{min-height:0;padding-top:52px}.site-footer--photo .footer-details{padding-bottom:35px}.site-footer--photo .footer-base{margin-bottom:0}.footer-wordmark-outline{font-size:clamp(110px,25vw,190px)}}
</style>
