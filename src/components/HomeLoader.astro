<div class="home-loader" data-home-loader role="status" aria-label="Loading Agama Design Collective">
  <div class="loader-mark" aria-hidden="true">
    <img src="/brand/agama-logo-loader.png" alt="" width="1797" height="1797" />
    <svg class="loader-ring" viewBox="0 0 112 112">
      <defs>
        <linearGradient id="agama-loader-gradient" x1="8" y1="8" x2="104" y2="104" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#1554b8" />
          <stop offset=".52" stop-color="#1554b8" />
          <stop offset="1" stop-color="#75ed91" />
        </linearGradient>
      </defs>
      <circle class="loader-progress" cx="56" cy="56" r="49" pathLength="100" />
    </svg>
  </div>
  <span class="loader-label">Agama Design Collective</span>
</div>

<script>
  const loader = document.querySelector<HTMLElement>('[data-home-loader]');
  const loaderKey = 'agama-home-intro-seen';

  if (loader) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const forcePreview = new URLSearchParams(window.location.search).has('loader-preview');
    const alreadySeen = sessionStorage.getItem(loaderKey) === 'true' && !forcePreview;

    if (alreadySeen || reducedMotion) {
      loader.remove();
    } else {
      document.documentElement.classList.add('loader-active');
      const minimumDisplay = new Promise((resolve) => window.setTimeout(resolve, 2900));
      const pageReady = document.readyState === 'complete'
        ? Promise.resolve()
        : new Promise((resolve) => window.addEventListener('load', resolve, { once: true }));

      Promise.all([minimumDisplay, pageReady]).then(() => {
        sessionStorage.setItem(loaderKey, 'true');
        loader.classList.add('is-complete');
        document.documentElement.classList.remove('loader-active');
        window.setTimeout(() => loader.remove(), 650);
      });
    }
  }
</script>

<style>
  :global(html.loader-active),
  :global(html.loader-active body) { overflow: hidden; }
  .home-loader {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    background: #fff;
    opacity: 1;
    visibility: visible;
    transition: opacity 620ms var(--ease-out), visibility 620ms;
  }
  .home-loader.is-complete {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .loader-mark {
    position: relative;
    width: clamp(132px, 12vw, 174px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .loader-mark img {
    display: block;
    width: 78%;
    height: 78%;
    object-fit: contain;
    opacity: 0;
    transform: scale(.92);
    animation: logo-arrive 700ms var(--ease-out) 120ms forwards;
  }
  .loader-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(-90deg);
  }
  .loader-progress {
    fill: none;
    stroke-width: 2.2;
  }
  .loader-progress {
    stroke: url(#agama-loader-gradient);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw-ring 2500ms cubic-bezier(.65, 0, .18, 1) 160ms forwards;
  }
  .loader-label {
    color: #4d4945;
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 450;
    letter-spacing: .045em;
    opacity: 0;
    animation: label-arrive 700ms var(--ease-out) 700ms forwards;
  }
  @keyframes draw-ring { to { stroke-dashoffset: 0; } }
  @keyframes logo-arrive { to { opacity: 1; transform: scale(1); } }
  @keyframes label-arrive { to { opacity: 1; transform: translateY(0); } from { transform: translateY(5px); } }
  @media (prefers-reduced-motion: reduce) { .home-loader { display: none; } }
</style>
