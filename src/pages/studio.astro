---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import kiran from '../assets/studio/kiran.jpg';
import akash from '../assets/studio/akash.jpeg';
import arjun from '../assets/studio/arjun.jpeg';
import explodedBase from '../assets/studio/client-exploded-layers/layer-1.png';
import explodedUpper from '../assets/studio/client-exploded-layers/layer-2.png';
import explodedTerrace from '../assets/studio/client-exploded-layers/layer-3.png';
import explodedRoof from '../assets/studio/client-exploded-layers/layer-4.png';
import ponmilyBuildito from '../assets/studio/publication-ponmily-buildito.jpg';
import ponmilyShortOne from '../assets/studio/publication-ponmily-short-1.jpg';
import ponmilyShortTwo from '../assets/studio/publication-ponmily-short-2.jpg';
import geethalayamFeature from '../assets/studio/publication-geethalayam.jpg';
import designerCover from '../assets/studio/designer-cover.png';
import ponmilySketch from '../../projects/Project 1 - Ponmily Residence/Sketch.png';
import publicationPonmilyOne from '../../projects/Project 1 - Ponmily Residence/_Z621844.jpg';
import publicationPonmilyTwo from '../../projects/Project 1 - Ponmily Residence/_Z622041.jpg';
import publicationPonmilyThree from '../../projects/Project 1 - Ponmily Residence/_Z621957-HDR.jpg';
import publicationGeethalayam from '../../projects/Project 3- Geethalayam renovation/_DSC9597.jpg';
---

<BaseLayout title="Studio | Agama Design Collective" description="The culture, process and people of Agama Design Collective in Kozhikode.">
  <section class="studio-scroll-story" aria-labelledby="studio-title">
    <div class="studio-hero-runway" data-studio-hero>
    <header class="studio-story-intro">
      <p class="eyebrow">Studio · Kozhikode</p>
      <h1 id="studio-title">Thoughtful, tailor-made spaces.</h1>
      <p>Architecture shaped by place, natural materials and the people who inhabit it.</p>
      <div class="studio-transition-copy" aria-hidden="true">
        <span>Studio · Kozhikode</span>
        <strong>Thoughtful, tailor-made spaces.</strong>
        <p>Architecture shaped by place, natural materials and the people who inhabit it.</p>
      </div>
      <Image class="studio-transition-sketch" src={ponmilySketch} alt="" widths={[700,1100,1500]} sizes="55vw" />
    </header>
    </div>
    <div class="architectural-sequence" data-architectural-sequence>
      <div class="architectural-stage">
        <figure class="architectural-drawing" role="img" aria-label="Geethalayam assembling into an exploded architectural study">
          <Image class="drawing-layer drawing-layer--base" src={explodedBase} alt="" format="png" widths={[760,1158]} sizes="(max-width: 700px) 110vw, 75vw" />
          <Image class="drawing-layer drawing-layer--upper" src={explodedUpper} alt="" format="png" widths={[760,1158]} sizes="(max-width: 700px) 110vw, 75vw" />
          <Image class="drawing-layer drawing-layer--terrace" src={explodedTerrace} alt="" format="png" widths={[760,1158]} sizes="(max-width: 700px) 110vw, 75vw" />
          <Image class="drawing-layer drawing-layer--roof" src={explodedRoof} alt="" format="png" widths={[760,1158]} sizes="(max-width: 700px) 110vw, 75vw" />
        </figure>
        <div class="architectural-captions" aria-label="Agama's approach">
          <div class="approach-heading"><span>Agama Design Collective</span><h2>Our approach.</h2></div>
          <article class="architectural-caption architectural-caption--left is-active" data-architectural-caption>
            <span>Context</span><h2>Begin with what is already there.</h2><p>Read the landscape, climate, orientation and existing vegetation.</p>
          </article>
          <article class="architectural-caption architectural-caption--right" data-architectural-caption>
            <span>Purpose</span><h2>Balance place and aspiration.</h2><p>Place, client aspirations and contemporary design are considered together.</p>
          </article>
          <article class="architectural-caption architectural-caption--left" data-architectural-caption>
            <span>Materials</span><h2>Choose what belongs.</h2><p>Materials and construction methods respond to the project and its context.</p>
          </article>
          <article class="architectural-caption architectural-caption--right" data-architectural-caption>
            <span>Landscape</span><h2>Let building and land belong together.</h2><p>Landscape is integral, creating a stronger connection with nature.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="people" id="people" aria-labelledby="people-title" data-people-chapter>
    <header class="section-heading people-heading" data-reveal>
      <div><p class="eyebrow">People</p><h2 id="people-title">Small by choice. Close to the work.</h2></div>
    </header>
    <div class="team-showcase" data-team data-reveal>
      <div class="team-portraits" aria-label="Agama team portraits">
        <button class="portrait portrait--arjun" type="button" data-member="arjun" aria-label="Show Arjun K. V."><Image src={arjun} alt="" widths={[360,520,700]} sizes="(max-width: 700px) 42vw, 16vw" /></button>
        <button class="portrait portrait--akash" type="button" data-member="akash" aria-label="Show Akash"><Image src={akash} alt="" widths={[360,520,700]} sizes="(max-width: 700px) 42vw, 16vw" /></button>
        <button class="portrait portrait--kiran" type="button" data-member="kiran" aria-label="Show Kiran P"><Image src={kiran} alt="" widths={[420,640,860]} sizes="(max-width: 700px) 46vw, 22vw" /></button>
      </div>
      <div class="team-roster" role="tablist" aria-label="Agama team members">
        <button class="member-row" type="button" data-member="kiran" role="tab" aria-selected="false"><span class="member-mark"></span><span><strong>Kiran P</strong><small>Founder · Principal Architect</small></span></button>
        <button class="member-row" type="button" data-member="akash" role="tab" aria-selected="false"><span class="member-mark"></span><span><strong>Akash</strong><small>Architect</small></span></button>
        <button class="member-row" type="button" data-member="arjun" role="tab" aria-selected="false"><span class="member-mark"></span><span><strong>Arjun K. V.</strong><small>Architect</small></span></button>
        <div class="member-bios" aria-live="polite">
          <p class="member-bio" data-bio="kiran">Kiran’s work is guided by context, natural materials and human experience, informed by his time at Stapati Architects and the Auroville Bamboo Centre.</p>
          <p class="member-bio" data-bio="akash">Akash works across planning, visualisation and technical documentation, with a focus on clear BIM-led coordination.</p>
          <p class="member-bio" data-bio="arjun">Arjun brings drawing and visual expression to design development, documentation and project execution.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="publications" aria-labelledby="publications-title" data-publications>
    <div class="publications-inner">
    <header class="section-heading" data-reveal><div><p class="eyebrow">Film, reels & press</p><h2 id="publications-title">Publications.</h2></div></header>
    <div class="film-strip" data-reveal data-publications-rail>
      <a class="film film--feature" href="https://youtu.be/qI-nawey334?si=vJD83_LUxIdhPmCc" target="_blank" rel="noreferrer" aria-label="Watch Ponmily Residence in Buildito"><span class="film-image"><Image src={publicationPonmilyOne} alt="Ponmily Residence in Buildito" widths={[700,1050,1400]} sizes="(max-width: 700px) 100vw, 48vw" /><span class="youtube-cue">Play on YouTube <b aria-hidden="true">▶</b></span></span></a>
      <a class="film" href="https://youtube.com/shorts/6G1r9pWKelU?si=YwllSwSLHfNHCH0a" target="_blank" rel="noreferrer" aria-label="Watch Ponmily Residence short film"><span class="film-image"><Image src={publicationPonmilyTwo} alt="Ponmily Residence short film" widths={[420,640,860]} sizes="(max-width: 700px) 100vw, 22vw" /><span class="youtube-cue">Play on YouTube <b aria-hidden="true">▶</b></span></span></a>
      <a class="film" href="https://youtube.com/shorts/dfKf2Ieh9D8?si=touxTTMfQI0iEip3" target="_blank" rel="noreferrer" aria-label="Watch Ponmily Residence detail film"><span class="film-image"><Image src={publicationPonmilyThree} alt="Ponmily Residence detail film" widths={[420,640,860]} sizes="(max-width: 700px) 100vw, 22vw" /><span class="youtube-cue">Play on YouTube <b aria-hidden="true">▶</b></span></span></a>
      <a class="film film--feature" href="https://youtu.be/9jg78TyPKCE?si=xXCsGFuRyZdxVwMW" target="_blank" rel="noreferrer" aria-label="Watch Geethalayam in Designer Plus"><span class="film-image"><Image src={publicationGeethalayam} alt="Geethalayam in Designer Plus" widths={[700,1050,1400]} sizes="(max-width: 700px) 100vw, 48vw" /><span class="youtube-cue">Play on YouTube <b aria-hidden="true">▶</b></span></span></a>
      <a class="film film--pdf" href="/publications/designer-may-2025.pdf" target="_blank" aria-label="Open Designer and Builder, May 2025 PDF"><span class="film-image"><Image src={designerCover} alt="Designer and Builder magazine, May 2025" widths={[420,640,860]} sizes="(max-width: 700px) 100vw, 22vw" /></span></a>
    </div>
    </div>
  </section>
  <SiteFooter variant="photo" />
</BaseLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduced) reveals.forEach((el) => el.classList.add('is-visible'));
  else { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .12, rootMargin: '0px 0px -7% 0px' }); reveals.forEach((el) => observer.observe(el)); }
  const studioHero = document.querySelector<HTMLElement>('[data-studio-hero]');
  if (studioHero && !reduced) {
    const heroSketch = studioHero.querySelector<HTMLElement>('.studio-transition-sketch');
    let heroFrame = 0;
    const renderHero = () => {
      heroFrame = 0;
      const rect = studioHero.getBoundingClientRect();
      const distance = Math.max(1, studioHero.offsetHeight - window.innerHeight - window.innerHeight * .15);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      const ease = progress * progress * (3 - 2 * progress);
      const targetWidth = window.innerWidth * (window.innerWidth < 701 ? .012 : .006);
      const targetHeight = window.innerHeight * (window.innerWidth < 701 ? .68 : .84);
      const targetWidthPercent = targetWidth / window.innerWidth * 100;
      const targetHeightPercent = targetHeight / window.innerHeight * 100;
      const right = (100 - targetWidthPercent) / 2;
      studioHero.style.setProperty('--hero-progress', String(ease));
      studioHero.style.setProperty('--hero-handoff', String(Math.min(1, Math.max(0, (rect.bottom - window.innerHeight * .7) / (window.innerHeight * .25)))));
      const sketchOpacity = Math.max(0, Math.min(1, (ease - .2) / .65));
      const photoOpacity = 1 - Math.max(0, Math.min(1, (ease - .74) / .26));
      studioHero.style.setProperty('--hero-sketch-opacity', String(sketchOpacity));
      studioHero.style.setProperty('--hero-photo-opacity', String(photoOpacity));
      if (heroSketch) heroSketch.style.opacity = String(sketchOpacity);
      studioHero.style.setProperty('--hero-clip-top', `${ease * (100 - targetHeightPercent) / 2}%`);
      studioHero.style.setProperty('--hero-clip-right', `${ease * right}%`);
      studioHero.style.setProperty('--hero-clip-bottom', `${ease * (100 - targetHeightPercent) / 2}%`);
      studioHero.style.setProperty('--hero-clip-left', `${ease * (100 - right - targetWidthPercent)}%`);
      studioHero.style.setProperty('--hero-image-scale', String(1.045 + ease * .07));
    };
    const requestHero = () => { if (!heroFrame) heroFrame = requestAnimationFrame(renderHero); };
    renderHero();
    window.addEventListener('scroll', requestHero, { passive: true });
    window.addEventListener('resize', requestHero);
  }
  const architecturalSequence = document.querySelector<HTMLElement>('[data-architectural-sequence]');
  if (architecturalSequence) {
    const captions = architecturalSequence.querySelectorAll<HTMLElement>('[data-architectural-caption]');
    const clamp = (value:number) => Math.min(1, Math.max(0, value));
    if (reduced) architecturalSequence.classList.add('is-reduced');
    else {
      let architectureFrame = 0;
      let targetProgress = 0;
      let displayedProgress = 0;
      const reveal = (progress:number, start:number, end:number) => clamp((progress - start) / (end - start));
      const renderArchitecture = () => {
        const rect = architecturalSequence.getBoundingClientRect();
        const distance = Math.max(1, architecturalSequence.offsetHeight - window.innerHeight);
        targetProgress = clamp(-rect.top / distance);
        displayedProgress += (targetProgress - displayedProgress) * .12;
        if (Math.abs(targetProgress - displayedProgress) < .0005) displayedProgress = targetProgress;
        const progress = displayedProgress;
        const readingLine = window.innerHeight * .5;
        let active = 0;
        let closest = Number.POSITIVE_INFINITY;
        const captionCenters:number[] = [];
        captions.forEach((caption, index) => {
          const captionRect = caption.getBoundingClientRect();
          const center = captionRect.top + captionRect.height / 2;
          captionCenters.push(center);
          const distanceToLine = Math.abs(center - readingLine);
          if (distanceToLine < closest) { closest = distanceToLine; active = index; }
        });
        const textDistance = Math.max(1, captionCenters.at(-1)! - captionCenters[0]);
        const textProgress = clamp((readingLine - captionCenters[0]) / textDistance);
        const upper = reveal(textProgress, .12, .28);
        const terrace = reveal(textProgress, .38, .54);
        const roof = reveal(textProgress, .64, .8);
        architecturalSequence.classList.toggle('is-pinned', rect.top <= 1);
        architecturalSequence.style.setProperty('--upper-opacity', String(upper));
        architecturalSequence.style.setProperty('--terrace-opacity', String(terrace));
        architecturalSequence.style.setProperty('--roof-opacity', String(roof));
        architecturalSequence.style.setProperty('--upper-y', `${(1 - upper) * 72}px`);
        architecturalSequence.style.setProperty('--terrace-y', `${(1 - terrace) * 88}px`);
        architecturalSequence.style.setProperty('--roof-y', `${(1 - roof) * 104}px`);
        architecturalSequence.style.setProperty('--drawing-scale', String(.99 + textProgress * .025));
        captions.forEach((caption, index) => caption.classList.toggle('is-active', index === active));
        architecturalSequence.dataset.activeStage = String(active);
        if (displayedProgress !== targetProgress) architectureFrame = requestAnimationFrame(renderArchitecture);
        else architectureFrame = 0;
      };
      const requestArchitecture = () => { if (!architectureFrame) architectureFrame = requestAnimationFrame(renderArchitecture); };
      displayedProgress = clamp(-architecturalSequence.getBoundingClientRect().top / Math.max(1, architecturalSequence.offsetHeight - window.innerHeight));
      renderArchitecture();
      window.addEventListener('scroll', requestArchitecture, { passive: true });
      window.addEventListener('resize', requestArchitecture);
    }
  }
  const peopleChapter = document.querySelector<HTMLElement>('[data-people-chapter]');
  if (peopleChapter) {
    if (reduced) peopleChapter.classList.add('is-entered');
    else {
      let peopleFrame = 0;
      const renderPeople = () => {
        peopleFrame = 0;
        const rect = peopleChapter.getBoundingClientRect();
        const top = rect.top;
        const shift = Math.min(110, Math.max(-24, (top - window.innerHeight) * .12));
        peopleChapter.style.setProperty('--people-shift', `${shift}px`);
        if (top < window.innerHeight * .82) peopleChapter.classList.add('is-entered');
      };
      const requestPeople = () => { if (!peopleFrame) peopleFrame = requestAnimationFrame(renderPeople); };
      renderPeople();
      window.addEventListener('scroll', requestPeople, { passive: true });
      window.addEventListener('resize', requestPeople);
    }
  }
  const publicationsSection = document.querySelector<HTMLElement>('[data-publications]');
  const publicationsRail = publicationsSection?.querySelector<HTMLElement>('[data-publications-rail]');
  if (publicationsSection && publicationsRail && !reduced) {
    let publicationsFrame = 0;
    const renderPublications = () => {
      publicationsFrame = 0;
      const rect = publicationsSection.getBoundingClientRect();
      const distance = Math.max(1, publicationsSection.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      const travel = Math.max(0, publicationsRail.scrollWidth - publicationsRail.clientWidth + window.innerWidth * .04);
      publicationsRail.style.transform = `translate3d(${-progress * travel}px,0,0)`;
    };
    const requestPublications = () => { if (!publicationsFrame) publicationsFrame = requestAnimationFrame(renderPublications); };
    renderPublications();
    window.addEventListener('scroll', requestPublications, { passive: true });
    window.addEventListener('resize', requestPublications);
  }
  document.querySelectorAll<HTMLElement>('[data-team]').forEach((team) => { const controls = team.querySelectorAll<HTMLButtonElement>('[data-member]'); const portraits = team.querySelectorAll<HTMLButtonElement>('.portrait'); const rows = team.querySelectorAll<HTMLButtonElement>('.member-row'); const bios = team.querySelectorAll<HTMLElement>('[data-bio]'); const activate = (id?:string) => { team.classList.toggle('has-active', Boolean(id)); portraits.forEach((item) => item.classList.toggle('is-active', item.dataset.member === id)); rows.forEach((item) => { const active = item.dataset.member === id; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); }); bios.forEach((item) => item.classList.toggle('is-active', item.dataset.bio === id)); }; controls.forEach((control) => { const select = () => activate(control.dataset.member); control.addEventListener('pointerenter', select); control.addEventListener('focus', select); control.addEventListener('click', select); }); team.addEventListener('pointerleave', () => activate()); team.addEventListener('focusout', (event) => { if (!team.contains(event.relatedTarget as Node)) activate(); }); });
</script>

<style>
  :global(body){background:#fff;color:#171916}.eyebrow{margin:0;color:#1554b8;font-size:14px;font-weight:600;letter-spacing:.1em;text-transform:uppercase}[data-reveal]{opacity:1;transform:none}.studio-hero,.process,.people,.publications{padding-inline:clamp(24px,6vw,96px)}
  .studio-hero{min-height:100svh;display:grid;grid-template-columns:minmax(310px,.78fr) minmax(560px,1.22fr);gap:clamp(50px,7vw,120px);align-items:center;padding-top:120px;padding-bottom:70px;overflow:hidden}.hero-copy{position:relative;z-index:2;max-width:540px}.hero-copy h1{max-width:10ch;margin:24px 0 0;font-size:clamp(46px,5vw,74px);font-weight:510;line-height:.96;letter-spacing:-.058em}.hero-copy>p:nth-of-type(2){max-width:44ch;margin:28px 0 0;color:#555852;font-size:17px;line-height:1.58}.hero-copy a{display:inline-flex;gap:14px;align-items:center;margin-top:40px;padding-bottom:5px;border-bottom:1px solid #171916;font-size:15px;font-weight:520}.hero-copy a span{color:#1554b8}.hero-canvas{--mx:0px;--my:0px;position:relative;min-height:650px}.hero-frame{position:absolute;margin:0;overflow:hidden;background:#dbe2dd}.hero-frame img{width:100%;height:100%;display:block;object-fit:cover}.hero-frame--main{right:-10vw;top:7%;width:92%;height:82%;clip-path:polygon(10% 0,100% 0,100% 100%,0 100%);transform:translate(var(--mx),var(--my));transition:transform .7s ease}.hero-frame--drawing{z-index:2;left:1%;top:3%;width:31%;aspect-ratio:1/1.22;transform:translate(calc(var(--mx)*-.5),calc(var(--my)*-.5)) rotate(-3deg);box-shadow:0 18px 50px rgba(24,45,35,.14)}.hero-frame--material{z-index:3;left:5%;bottom:0;width:25%;aspect-ratio:1/1.12;transform:translate(calc(var(--mx)*-.75),calc(var(--my)*-.75)) rotate(2deg);box-shadow:0 18px 50px rgba(24,45,35,.16)}.canvas-note{position:absolute;z-index:4;right:4%;bottom:3%;margin:0;color:#fff;font-size:14px;line-height:1.45;letter-spacing:.09em;text-transform:uppercase}
  .process{padding-top:105px;padding-bottom:115px;background:#eaf2ff}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:60px;margin-bottom:48px}.section-heading h2,.people-heading h2{margin:18px 0 0;font-size:clamp(38px,4.5vw,62px);font-weight:500;line-height:.98;letter-spacing:-.05em}.section-heading>p{max-width:42ch;margin:0;color:#4f5b68;font-size:16px;line-height:1.55}.process-deck{display:flex;height:560px;gap:12px}.process-card{position:relative;flex:1;min-width:0;overflow:hidden;border:0;border-radius:20px;padding:0;color:#fff;background:#18283b;text-align:left;cursor:pointer;transition:flex .7s var(--ease-out)}.process-card.is-active{flex:2.2}.process-card:focus-visible{outline:3px solid #1554b8;outline-offset:4px}.process-card:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.72))}.process-card img{width:100%;height:100%;display:block;object-fit:cover;filter:grayscale(.85);transition:filter .55s ease,transform .8s var(--ease-out)}.process-card.is-active img{filter:grayscale(0);transform:scale(1.018)}.process-number,.process-title,.process-text{position:absolute;z-index:1;left:24px}.process-number{top:24px;font-size:14px}.process-title{bottom:28px;font-size:clamp(22px,2.3vw,34px);font-weight:520}.process-text{right:25px;bottom:29px;left:auto;max-width:30ch;font-size:15px;line-height:1.45;opacity:0;transform:translateY(8px);transition:opacity .35s ease .2s,transform .35s ease .2s}.process-card.is-active .process-text{opacity:1;transform:none}.process-card.is-active .process-title{bottom:85px}
