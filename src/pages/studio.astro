---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Studio — Agama Design Collective" description="The culture, approach and people of Agama Design Collective."><section class="page"><p class="eyebrow">Studio</p><h1>We learn from the past, respond to the present and remain open to the future.</h1><p>Agama is a boutique architecture practice based in Kozhikode, Kerala, led by Principal Architect Kiran P.</p></section></BaseLayout>
<style>.page{min-height:100svh;display:grid;align-content:center;gap:30px;max-width:1200px;margin:auto;padding:130px 28px}.page h1{max-width:1050px;margin:0;font-family:var(--font-display);font-size:clamp(48px,7.2vw,105px);font-weight:430;line-height:.98;letter-spacing:-.04em}.page>p:last-child{max-width:620px;font-size:18px;line-height:1.55}</style>
