---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/ponmily-hero.jpg';
---

<BaseLayout title="Agama Design Collective — Architecture rooted in place" description="Agama Design Collective is a boutique architecture practice in Kozhikode, Kerala." showNav={false}>
  <section class="hero" aria-labelledby="studio-title">
    <nav class="concept-switcher" aria-label="Homepage concept switcher">
      <span aria-current="page">Option 1</span>
      <a href="/home-v9">Option 2</a>
    </nav>
    <div class="hero-copy">
      <div class="brand-lockup">
        <img class="studio-logo" src="/brand/agama-logo.png" alt="Agama Design Collective logo" width="2859" height="2768" />
        <h1 id="studio-title"><span class="studio-name">Agama</span><span class="studio-descriptor">Design Collective</span></h1>
      </div>
      <p class="philosophy">Architecture rooted in place, responsive to people,<br class="desktop-break" /> and open to the future.</p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button--contact" href="/contact">Contact us</a>
        <a class="button button--studio" href="/studio">
          <span>Explore the studio</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="image-mask"><Image src={heroImage} alt="" widths={[720, 1080, 1600]} sizes="(max-width: 760px) 100vw, 58vw" loading="eager" fetchpriority="high" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100svh; overflow: hidden; background: #fff; }
  .concept-switcher {
    position: fixed; z-index: 20; right: 18px; bottom: 18px; display: flex; gap: 3px;
    padding: 4px; border-radius: 999px; background: rgba(255,255,255,.88);
    box-shadow: 0 8px 30px rgba(20,18,15,.12); backdrop-filter: blur(12px);
    font-family: var(--font-primary); font-size: 14px; color: #282522;
  }
  .concept-switcher a, .concept-switcher span {
    min-height: 36px; padding: 0 13px; border-radius: 999px; display: inline-flex;
    align-items: center; justify-content: center;
  }
  .concept-switcher span { color: #fff; background: #211e1b; }
  .concept-switcher a:hover { background: #f1efec; }
  .hero-copy {
    position: relative; z-index: 2; width: 52%; min-height: 100svh;
    padding: 40px clamp(36px, 5vw, 96px); display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center; transform: translateY(-4vh);
  }
  .brand-lockup { display: flex; flex-direction: column; align-items: center; animation: brand-in 800ms var(--ease-out) 160ms both; }
  .studio-logo {
    display: block; width: clamp(168px, 10vw, 205px); height: auto; object-fit: contain;
    mix-blend-mode: multiply; margin-bottom: 7px;
  }
  h1 {
    margin: 0; color: #201d1b;
    font-family: 'Iowan Old Style', 'Baskerville', 'Palatino Linotype', Georgia, serif;
    letter-spacing: -.028em;
  }
  .studio-name, .studio-descriptor { display: block; }
  .studio-name { font-size: clamp(50px, 3.45vw, 66px); font-weight: 700; line-height: .98; }
  .studio-descriptor { margin-top: 6px; font-size: clamp(37px, 2.65vw, 51px); font-weight: 400; line-height: 1.05; }
  .philosophy {
    margin: 24px 0 0; color: #55514e; font-family: var(--font-primary);
    font-size: clamp(16px, 1.05vw, 20px); font-weight: 400; line-height: 1.58;
    letter-spacing: -.008em; text-wrap: balance; animation: copy-in 760ms var(--ease-out) 360ms both;
  }
  .hero-actions {
    display: flex; align-items: center; justify-content: center; gap: 13px; margin-top: 22px;
    animation: copy-in 720ms var(--ease-out) 520ms both;
  }
  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 48px;
    padding: 0 21px; border-radius: 999px; font-family: var(--font-primary); font-size: 15px;
    font-weight: 560; line-height: 1; transition: transform 220ms var(--ease-out), background-color 220ms ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button--contact { min-width: 122px; color: #211c18; border: 1px solid #cf9d71; background: #fff; }
  .button--contact:hover { background: #f8eee5; }
  .button--studio { min-width: 199px; color: #211c18; border: 1px solid transparent; background: #dfb486; }
  .button--studio:hover { background: #d5a573; }
  .button--studio svg { transition: transform 220ms var(--ease-out); }
  .button--studio:hover svg, .button--studio:focus-visible svg { transform: translateX(4px); }
  .hero-visual {
    position: absolute; z-index: 1; inset: 0 0 0 48%; overflow: hidden;
    clip-path: polygon(13% 0, 100% 0, 100% 100%, 0 100%); background: #172017;
    animation: image-reveal 1100ms var(--ease-out) 80ms both;
  }
  .image-mask { position: absolute; inset: 0; overflow: hidden; }
  .image-mask :global(picture), .image-mask :global(img) { width: 100%; height: 100%; }
  .image-mask :global(picture) { display: block; animation: image-drift 14s ease-in-out 2s infinite alternate; transform-origin: center; }
  .image-mask :global(img) { display: block; object-fit: cover; object-position: 49% 52%; animation: image-settle 1700ms var(--ease-out) 120ms both; }
  @keyframes brand-in { from { opacity: 0; transform: translateY(14px) scale(.99); } }
  @keyframes copy-in { from { opacity: 0; transform: translateY(14px); } }
  @keyframes image-reveal { from { opacity: 0; clip-path: polygon(100% 0, 100% 0, 100% 100%, 83% 100%); } }
  @keyframes image-settle { from { transform: scale(1.1); filter: saturate(.78); } to { transform: scale(1.01); filter: none; } }
  @keyframes image-drift { from { transform: scale(1.01) translate3d(0, 0, 0); } to { transform: scale(1.035) translate3d(-.6%, -.35%, 0); } }
  @media (max-width: 980px) and (min-width: 761px) {
    .hero-copy { width: 55%; padding-inline: 26px; } .hero-visual { left: 52%; }
    .studio-logo { width: 145px; } .studio-name { font-size: 45px; } .studio-descriptor { font-size: 33px; }
    .philosophy { max-width: 390px; font-size: 16px; }
  }
  @media (max-width: 760px) {
    .hero { min-height: 100svh; display: grid; grid-template-rows: 43svh minmax(57svh, auto); }
    .hero-visual {
      position: relative; grid-row: 1; inset: auto; width: 100%; height: 43svh;
      clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
    }
    .hero-copy { grid-row: 2; width: 100%; min-height: 57svh; padding: 24px 20px 26px; transform: translateY(-1.5vh); }
    .studio-logo { width: 112px; margin-bottom: 4px; }
    .studio-name { font-size: clamp(36px, 11vw, 45px); }
    .studio-descriptor { margin-top: 5px; font-size: clamp(28px, 8.3vw, 34px); }
    .philosophy { max-width: 35ch; margin-top: 17px; font-size: 15px; line-height: 1.5; }
    .desktop-break { display: none; }
    .hero-actions { gap: 9px; margin-top: 18px; }
    .button { min-height: 46px; padding-inline: 17px; font-size: 14px; }
    .button--contact { min-width: 112px; } .button--studio { min-width: 177px; }
  }
  @media (max-width: 350px) {
    .hero-actions { width: 100%; } .button { padding-inline: 13px; }
    .button--contact { min-width: 104px; } .button--studio { min-width: 169px; }
  }
  @media (max-height: 720px) and (min-width: 761px) {
    .studio-logo { width: 134px; } .studio-name { font-size: 45px; } .studio-descriptor { font-size: 34px; }
    .philosophy { margin-top: 18px; } .hero-actions { margin-top: 17px; }
  }
</style>
