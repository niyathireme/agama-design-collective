---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/ponmily-hero.jpg';
---

<BaseLayout title="Agama Design Collective — Architecture rooted in place" description="Agama Design Collective is a boutique architecture practice in Kozhikode, Kerala.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="identity">
        <span>Agama Design Collective</span>
      </div>

      <h1 id="hero-title">Architecture rooted in place, responsive to people, and open to the future.</h1>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button--primary" href="/projects">See projects</a>
        <a class="button button--secondary" href="/contact">Contact us</a>
      </div>
    </div>

    <a class="hero-visual" href="/projects" aria-label="See Agama's projects">
      <span class="visual-field" aria-hidden="true"></span>
      <div class="image-mask">
        <Image src={heroImage} alt="Ponmily Residence among mature trees at dusk" widths={[720, 1080, 1600]} sizes="(max-width: 760px) 100vw, 58vw" loading="eager" fetchpriority="high" />
      </div>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(410px, .82fr) minmax(550px, 1.18fr);
    background:
      radial-gradient(circle at 7% 82%, rgba(117, 237, 145, .18), transparent 28%),
      var(--field-paper);
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    align-self: center;
    max-width: 720px;
    padding: 126px clamp(28px, 5.4vw, 88px) 70px clamp(36px, 6vw, 104px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    color: var(--field-ink);
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 430;
    letter-spacing: .01em;
    animation: copy-in 680ms var(--ease-out) 280ms both;
  }
  h1 {
    margin: 0;
    color: var(--field-ink);
    font-family: var(--font-primary);
    font-size: clamp(46px, 4.65vw, 76px);
    font-weight: 640;
    line-height: 1.09;
    letter-spacing: -.04em;
    text-wrap: balance;
    animation: copy-in 820ms var(--ease-out) 360ms both;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; animation: copy-in 720ms var(--ease-out) 500ms both; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 158px;
    min-height: 54px;
    padding: 0 22px;
    border: 0;
    border-radius: 12px;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 450;
    transition: transform 180ms var(--ease-out), background-color 180ms ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button--primary { color: #fff; background: var(--cobalt); }
  .button--primary:hover { background: var(--cobalt-deep); }
  .button--secondary { color: var(--field-ink); background: var(--field-green); }
  .button--secondary:hover { background: #91f3a7; }
  .hero-visual { position: absolute; z-index: 2; inset: 0 0 0 43%; overflow: hidden; }
  .visual-field { position: absolute; inset: 0; background: var(--field-green); clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%); animation: field-in 950ms var(--ease-out) 80ms both; }
  .image-mask { position: absolute; inset: 0 0 0 10px; overflow: hidden; clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%); background: var(--field-muted); animation: image-reveal 1100ms var(--ease-out) 150ms both; }
  .image-mask :global(picture), .image-mask :global(img) { width: 100%; height: 100%; }
  .image-mask :global(img) { display: block; object-fit: cover; object-position: 48% 52%; animation: image-settle 1700ms var(--ease-out) 170ms both; transition: transform 650ms var(--ease-out); }
  .hero-visual:hover .image-mask :global(img) { transform: scale(1.035); }
  @keyframes copy-in { from { opacity: 0; transform: translateY(18px); } }
  @keyframes field-in { from { opacity: 0; clip-path: polygon(100% 0, 100% 0, 100% 100%, 83% 100%); } }
  @keyframes image-reveal { from { opacity: 0; clip-path: polygon(100% 0, 100% 0, 100% 100%, 83% 100%); } }
  @keyframes image-settle { from { transform: scale(1.12); filter: saturate(.72); } to { transform: scale(1.01); filter: none; } }

  @media (max-width: 980px) and (min-width: 761px) {
    .hero { grid-template-columns: 47% 53%; }
    .hero-copy { padding-left: 36px; padding-right: 26px; }
    .identity { margin-bottom: 22px; }
    h1 { font-size: clamp(43px, 5.5vw, 58px); }
    .hero-visual { left: 45%; }
  }
  @media (max-width: 760px) {
    .hero { min-height: 100svh; grid-template-columns: 1fr; grid-template-rows: 49% 51%; }
    .hero-visual { inset: 0 0 auto; height: 49%; }
    .visual-field, .image-mask { clip-path: polygon(11% 0, 100% 0, 100% 100%, 0 100%); }
    .image-mask { inset: 0 0 0 7px; }
    .hero-copy { align-self: center; grid-row: 2; max-width: none; padding: 24px 18px 18px; }
    .identity { margin-bottom: 15px; font-size: 14px; }
    h1 { font-size: clamp(36px, 10vw, 50px); line-height: 1.07; }
    .hero-actions { gap: 8px; }
    .button { min-width: 142px; min-height: 48px; padding: 0 16px; }
  }
  @media (max-height: 720px) and (min-width: 761px) {
    .identity { margin-bottom: 20px; }
    h1 { font-size: clamp(42px, 4.35vw, 62px); }
    .hero-actions { margin-top: 30px; }
  }
</style>
