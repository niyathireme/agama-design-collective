---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Agama Design Collective" description="Contact Agama Design Collective in Kozhikode, Kerala."><section class="page"><p class="eyebrow">Start a conversation</p><h1>Have a place<br />in mind?</h1><a class="contact-link" href="https://wa.me/918139092123">Discuss a project on WhatsApp <span>↗</span></a><address>1/3758-B1, Bilathikulam Road<br />Nadakkavu, Kozhikode 673006</address></section></BaseLayout>
<style>.page{min-height:100svh;display:grid;align-content:center;gap:28px;padding:130px 7vw;background:var(--green);color:var(--paper)}.page h1{margin:0;font-family:var(--font-display);font-size:clamp(68px,12vw,180px);font-weight:430;line-height:.82;letter-spacing:-.05em}.contact-link{display:flex;justify-content:space-between;align-items:center;max-width:720px;min-height:64px;padding:0 22px;background:var(--paper);color:var(--ink);font-size:17px}.contact-link span{font-size:24px}address{margin-top:30px;font-style:normal;font-size:16px;line-height:1.55}</style>
