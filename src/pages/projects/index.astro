---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ponmilyPrimary from '../../assets/projects/ponmily-primary.jpg';
import ponmilyHover from '../../assets/projects/ponmily-hover.jpg';
import wilsonPrimary from '../../assets/projects/wilson-primary.jpg';
import wilsonHover from '../../assets/projects/wilson-hover.jpg';
import geethalayamPrimary from '../../assets/projects/geethalayam-primary.jpg';
import geethalayamHover from '../../assets/projects/geethalayam-hover.jpg';
import jebinPrimary from '../../assets/projects/jebin-primary.jpg';
import jebinHover from '../../assets/projects/jebin-hover.jpg';
import jaihindPrimary from '../../assets/projects/jaihind-primary.jpeg';
import jaihindHover from '../../assets/projects/jaihind-hover.jpg';
import kefPrimary from '../../assets/projects/kef-primary.jpg';
import kefHover from '../../assets/projects/kef-hover.jpg';

const projects = [
  { number:'01', title:'Ponmily Residence', type:'Residence · Parambil Bazar', description:'A calm family home shaped by natural light, ventilation and fluid transitions between indoors and landscape.', primary:ponmilyPrimary, hover:ponmilyHover, className:'project--wide' },
  { number:'02', title:'Wilson’s Cliff House', type:'Residence · Rammed earth', description:'Rammed-earth walls shape the boundary, arrival and relationship between the residence and its setting.', primary:wilsonPrimary, hover:wilsonHover, className:'project--compact' },
  { number:'03', title:'Geethalayam', type:'Restoration · Kozhikode', description:'A 1965 Malabar home restored with measured interventions that preserve its character, materiality and spatial memory.', primary:geethalayamPrimary, hover:geethalayamHover, href:'/projects/geethalayam', className:'project--tall' },
  { number:'04', title:'Jebin Residence', type:'Interior transformation', description:'An existing home reworked through clearer planning, refined finishes and contemporary interiors.', primary:jebinPrimary, hover:jebinHover, className:'project--standard' },
  { number:'05', title:'Jaihind Commercial', type:'Commercial · Kozhikode', description:'A layered commercial frontage where brick, planting and illuminated shopfronts shape a lively street presence.', primary:jaihindPrimary, hover:jaihindHover, className:'project--compact' },
  { number:'06', title:'KEF Experience Centre', type:'Retail · Calicut', description:'A restrained retail environment that gives clothing, texture and colour visual priority.', primary:kefPrimary, hover:kefHover, className:'project--wide' }
];
---

<BaseLayout title="Projects — Agama Design Collective" description="Six selected architecture, restoration, interior and retail projects by Agama Design Collective.">
  <header class="projects-intro">
    <h1>Projects shaped by<br />place and people.</h1>
    <p class="intro-copy">A selection of residences, restorations and interiors across Kerala—each approached through material clarity, climate and everyday life.</p>
  </header>

  <section class="project-grid" aria-label="Selected projects">
    {projects.map((project) => {
      const Tag = project.href ? 'a' : 'article';
      return (
        <Tag class:list={['project', project.className]} href={project.href}>
          <div class="project-media">
            <Image class="project-image project-image--primary" src={project.primary} alt={project.title} widths={[600,900,1400]} sizes="(max-width: 760px) 100vw, 50vw" />
            <Image class="project-image project-image--hover" src={project.hover} alt="" widths={[600,900,1400]} sizes="(max-width: 760px) 100vw, 50vw" />
            {project.href && <span class="view-cue" aria-hidden="true">View project ↗</span>}
          </div>
          <div class="project-heading"><h2>{project.title}</h2></div>
          <p class="project-type">{project.type}</p>
          <p class="project-description">{project.description}</p>
        </Tag>
      );
    })}
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  :global(body){background:#fff}
  .projects-intro{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);column-gap:60px;align-items:end;padding:190px clamp(24px,5vw,80px) 96px;background:#fff}
  .intro-kicker{grid-column:1/-1;margin:0 0 40px;color:#1554b8;font-size:14px;font-weight:610;letter-spacing:.09em;text-transform:uppercase}
  h1{margin:0;color:#191816;font-family:var(--font-primary);font-size:clamp(54px,7.4vw,118px);font-weight:520;line-height:.91;letter-spacing:-.06em}
  .intro-copy{max-width:43ch;margin:0 0 7px;color:#55514e;font-size:17px;font-weight:400;line-height:1.55}
  .project-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:92px 24px;padding:0 clamp(24px,5vw,80px) 150px;background:#fff}
  .project{grid-column:span 6;min-width:0;color:#191816}
  .project:nth-child(even){margin-top:100px}
  .project-media{position:relative;overflow:hidden;aspect-ratio:4/3;border-radius:14px;background:#e9e8e4}
  .project--wide .project-media{aspect-ratio:1.42/1}.project--compact .project-media{aspect-ratio:1.08/1}.project--tall .project-media{aspect-ratio:.95/1}
  .project-image{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;transition:opacity 620ms var(--ease-out),transform 900ms var(--ease-out),filter 620ms ease}
  .project-image--primary{opacity:1;transform:scale(1.001)}.project-image--hover{opacity:0;transform:scale(1.055)}
  .project:hover .project-image--primary,.project:focus-visible .project-image--primary{opacity:0;transform:scale(1.035)}
  .project:hover .project-image--hover,.project:focus-visible .project-image--hover{opacity:1;transform:scale(1.001)}
  .view-cue{position:absolute;right:16px;bottom:16px;z-index:2;padding:10px 14px;border-radius:999px;color:#151515;background:rgba(255,255,255,.9);font-size:14px;font-weight:520;opacity:0;transform:translateY(9px);transition:opacity 260ms ease,transform 260ms var(--ease-out)}
  a.project:hover .view-cue,a.project:focus-visible .view-cue{opacity:1;transform:none}
  .project-heading{margin-top:21px}
  h2{margin:0;font-size:clamp(24px,2.2vw,34px);font-weight:540;line-height:1.08;letter-spacing:-.035em}
  .project-type{margin:9px 0 0;color:#1554b8;font-size:14px;font-weight:540}
  .project-description{max-width:51ch;margin:15px 0 0;color:#595550;font-size:16px;line-height:1.52}
  @media(max-width:820px){.projects-intro{display:block;padding-top:150px;padding-bottom:72px}.intro-kicker{margin-bottom:28px}h1{font-size:clamp(52px,13vw,86px)}.intro-copy{margin-top:30px;font-size:16px}.project-grid{display:block;padding-bottom:100px}.project,.project:nth-child(even){margin:0 0 70px}.project-media,.project--wide .project-media,.project--compact .project-media,.project--tall .project-media{aspect-ratio:1.18/1}.project-heading{margin-top:17px}.project-description{font-size:15px}}
  @media(hover:none){.view-cue{display:none}}
  .projects-intro,.project-grid{position:relative;z-index:2}
  .project-grid{margin-bottom:420px}
  :global(.site-footer){position:fixed;z-index:0;right:0;bottom:0;left:0;width:100%;min-height:420px}
  @media(max-width:700px){.project-grid{margin-bottom:500px}:global(.site-footer){min-height:500px}}
</style>
